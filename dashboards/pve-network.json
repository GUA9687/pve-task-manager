        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pve-prom"
      },
      "targets": [
        {
          "expr": "irate(node_network_receive_bytes_total{machine=\"$machine\",device!=\"lo\"}[5m])",

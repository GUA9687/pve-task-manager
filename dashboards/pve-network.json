{
  "uid": "pve-network",
  "title": "网络 · 接口流量",
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "style": "dark",
  "timezone": "Asia/Shanghai",
  "refresh": "1s",
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "PVE",
    "任务管理器"
  ],
  "graphTooltip": 1,
  "panels": [
    {
      "title": "总接收",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pve-prom"
      },
      "targets": [
        {
          "expr": "lab:network_receive_bytes_per_second{machine=\"$machine\"}",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pve-prom"
          },
          "instant": true,
          "range": false
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF9830"
          },
          "decimals": 1,
          "noValue": "—",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 20
        }
      },
      "id": 1
    },

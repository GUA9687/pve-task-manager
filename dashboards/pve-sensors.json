{
  "uid": "pve-sensors",
  "title": "传感器 · 温度与风扇",
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "style": "dark",
  "timezone": "Asia/Shanghai",
  "refresh": "1s",
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "PVE",
    "任务管理器"
  ],
  "graphTooltip": 1,
  "panels": [
    {
      "title": "CPU / CCD 温度",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pve-prom"
      },
      "targets": [
        {
          "expr": "node_hwmon_temp_celsius{machine=\"pve\"} * on(machine,chip,instance,job) group_left(chip_name) node_hwmon_chip_names{machine=\"pve\",chip_name=\"k10temp\"}",
          "legendFormat": "{{chip}} {{sensor}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pve-prom"
          },
          "instant": false,
          "range": true
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": {
            "mode": "fixed",
            "fixedColor": "#FFB357"
          },
          "decimals": 1,
          "noValue": "—",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "",
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 1,
      "maxDataPoints": 240
    },
    {

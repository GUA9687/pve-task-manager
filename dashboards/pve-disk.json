    {
      "title": "文件系统使用率",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pve-prom"
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{machine=\"$machine\",fstype!~\"tmpfs|devtmpfs|squashfs|overlay\"}/node_filesystem_size_bytes{machine=\"$machine\",fstype!~\"tmpfs|devtmpfs|squashfs|overlay\"})",
          "legendFormat": "{{mountpoint}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pve-prom"
          },
          "instant": true,
          "range": false
        },
        {
          "expr": "100 * (1 - windows_logical_disk_free_bytes{machine=\"$machine\",volume=~\"[A-Z]:\"}/windows_logical_disk_size_bytes{machine=\"$machine\",volume=~\"[A-Z]:\"})",
          "legendFormat": "{{volume}}",
          "refId": "B",
